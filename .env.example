#DJANGO SETTINGS
#Set a long, random string of at least 50 characters
SECRET_KEY=long-random-string

#SETTINGS MODULE
#select development (dev) or production (prod) settings.
DJANGO_SETTINGS_MODULE=config.settings.dev
#DJANGO_SETTINGS_MODULE=config.settings.prod

#PRODUCTION DATABASE CONNECTION
DB_NAME=dbwm
DB_USER=dbwmuser
DB_PASSWORD=123456
DB_HOST=dbhost.example.com
DB_PORT=5432
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

#PRODUCTION HOST
RENDER_EXTERNAL_HOSTNAME=page.example.com
